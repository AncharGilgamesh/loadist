/* Учебная тема: тёплая бумага, чернила, тёмно-синий и латунь. */

QWidget {
    background-color: #f3eee4;
    color: #243038;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMainWindow, QDialog, QMessageBox {
    background-color: #f3eee4;
}

QMenuBar {
    background-color: #1e3a4c;
    color: #f7f3ea;
    padding: 2px 8px;
    spacing: 4px;
}

QMenuBar::item {
    background: transparent;
    color: #f7f3ea;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #2c5270;
}

QMenu {
    background-color: #fffcf7;
    color: #243038;
    border: 1px solid #d9d0c3;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 28px 6px 16px;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: #f3e6d0;
    color: #1e3a4c;
}

QMenu::separator {
    height: 1px;
    background: #e4d9c8;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #e6dfd2;
    color: #5e564c;
    border-top: 1px solid #d9d0c3;
}

QLabel {
    background: transparent;
}

QLabel[role="section"] {
    font-family: "Palatino Linotype";
    font-size: 16pt;
    color: #1e3a4c;
    padding: 2px 0 6px 0;
}

QPushButton {
    background-color: #fffcf7;
    color: #1e3a4c;
    border: 1px solid #cbbfae;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 26px;
}

QPushButton:hover {
    background-color: #f6ecda;
    border-color: #8c6a3d;
}

QPushButton:pressed {
    background-color: #ead9b8;
}

QPushButton:disabled {
    color: #a3988c;
    background-color: #efeae1;
    border-color: #ddd4c6;
}

QPushButton#goToMainButton,
QPushButton#goToKafedraButton {
    background: transparent;
    border: 1px solid transparent;
    color: #1e3a4c;
    font-family: "Palatino Linotype";
    font-size: 13pt;
    padding: 4px 18px;
    min-height: 32px;
}

QPushButton#goToMainButton:hover,
QPushButton#goToKafedraButton:hover {
    background-color: #e7dcc8;
    border-color: transparent;
}

QPushButton#goToMainButton[active="true"],
QPushButton#goToKafedraButton[active="true"] {
    background-color: #1e3a4c;
    color: #f7f3ea;
    border: 1px solid #1e3a4c;
}

QPushButton#goToMainButton[active="true"]:hover,
QPushButton#goToKafedraButton[active="true"]:hover {
    background-color: #2c5270;
    border-color: #2c5270;
}

QPushButton#transferButton,
QPushButton#loadButton,
QPushButton#saveMainNagruzka,
QPushButton#savePreodButton,
QPushButton#saveWorkTblsButton,
QPushButton#saveStatButton,
QPushButton#saveDisButton,
QPushButton#saveNapPodButton,
QPushButton#saveGroups,
QPushButton#saveDoljnostiButton,
QPushButton#saveButton {
    background-color: #1e3a4c;
    color: #f7f3ea;
    border: 1px solid #1e3a4c;
}

QPushButton#transferButton:hover,
QPushButton#loadButton:hover,
QPushButton#saveMainNagruzka:hover,
QPushButton#savePreodButton:hover,
QPushButton#saveWorkTblsButton:hover,
QPushButton#saveStatButton:hover,
QPushButton#saveDisButton:hover,
QPushButton#saveNapPodButton:hover,
QPushButton#saveGroups:hover,
QPushButton#saveDoljnostiButton:hover,
QPushButton#saveButton:hover {
    background-color: #2c5270;
    border-color: #2c5270;
}

QPushButton#addPrepodButton,
QPushButton#addWorkTblButton,
QPushButton#addDisciplineButton,
QPushButton#addNapPodButton,
QPushButton#addGroupButton,
QPushButton#addDoljnostButton,
QPushButton#refreshStatButton,
QPushButton#confirmButton,
QPushButton#addNapPod {
    background-color: #f3e6d0;
    color: #1e3a4c;
    border: 1px solid #8c6a3d;
}

QPushButton#addPrepodButton:hover,
QPushButton#addWorkTblButton:hover,
QPushButton#addDisciplineButton:hover,
QPushButton#addNapPodButton:hover,
QPushButton#addGroupButton:hover,
QPushButton#addDoljnostButton:hover,
QPushButton#refreshStatButton:hover,
QPushButton#confirmButton:hover,
QPushButton#addNapPod:hover {
    background-color: #ead7b4;
}

QPushButton#delPrepodButton,
QPushButton#delWorkTblButton,
QPushButton#delCurrDisButton,
QPushButton#delCurrNapButton,
QPushButton#delCurrentGrButton,
QPushButton#delCurrentDoljnostButton,
QPushButton#delAllPrepodButton,
QPushButton#delAllWorkTblsButton,
QPushButton#dellAllDisButton,
QPushButton#dellAllNapPod,
QPushButton#dellAllGrButton,
QPushButton#delAllDoljnostiButton {
    background-color: #fffcf7;
    color: #7a3e3a;
    border: 1px solid #d2aaa4;
}

QPushButton#delPrepodButton:hover,
QPushButton#delWorkTblButton:hover,
QPushButton#delCurrDisButton:hover,
QPushButton#delCurrNapButton:hover,
QPushButton#delCurrentGrButton:hover,
QPushButton#delCurrentDoljnostButton:hover,
QPushButton#delAllPrepodButton:hover,
QPushButton#delAllWorkTblsButton:hover,
QPushButton#dellAllDisButton:hover,
QPushButton#dellAllNapPod:hover,
QPushButton#dellAllGrButton:hover,
QPushButton#delAllDoljnostiButton:hover {
    background-color: #f8e8e4;
    border-color: #7a3e3a;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #fffcf7;
    color: #243038;
    border: 1px solid #cbbfae;
    border-radius: 4px;
    min-height: 26px;
    selection-background-color: #e7d3a8;
    selection-color: #243038;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #1e3a4c;
}

QLineEdit:disabled, QComboBox:disabled {
    background-color: #efeae1;
    color: #8d8478;
}

QComboBox QAbstractItemView {
    background-color: #fffcf7;
    color: #243038;
    selection-background-color: #f3e6d0;
    selection-color: #1e3a4c;
    border: 1px solid #d9d0c3;
    outline: 0;
}

QCheckBox, QRadioButton {
    background: transparent;
    spacing: 8px;
}

QTabWidget::pane {
    background-color: #f7f4ee;
    border: 1px solid #d9d0c3;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #6b6258;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    margin-right: 2px;
    font-size: 10pt;
}

QTabBar::tab:selected {
    color: #1e3a4c;
    border-bottom: 2px solid #8c6a3d;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #1e3a4c;
    background-color: #f6ecda;
}

QTableView {
    background-color: #fffcf7;
    alternate-background-color: #f7f1e6;
    color: #243038;
    gridline-color: #e6ddd0;
    border: 1px solid #d9d0c3;
    selection-background-color: #e7d3a8;
    selection-color: #243038;
    font-size: 9pt;
}

QHeaderView::section {
    background-color: #1e3a4c;
    color: #f7f3ea;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #2c5270;
    font-size: 9pt;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #1e3a4c;
    border: none;
}

QScrollBar:vertical {
    background: #efeae1;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c4b49a;
    min-height: 28px;
    border-radius: 4px;
}

QScrollBar:horizontal {
    background: #efeae1;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #c4b49a;
    min-width: 28px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QToolTip {
    background-color: #1e3a4c;
    color: #f7f3ea;
    border: none;
    padding: 4px 8px;
}
